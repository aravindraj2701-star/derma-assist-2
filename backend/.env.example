# =============================================
# DERMA ASSIST — Environment Configuration
# =============================================
# Copy this file to .env and fill in your values

# ----- Database -----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/derma_assist

# ----- Authentication -----
GOOGLE_CLIENT_ID=your-google-client-id-here
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ----- Model Paths -----
MODEL_PATH=../model/skin_model.h5
CLASS_NAMES_PATH=../model/class_names.json
MODEL_CONFIG_PATH=../model/model_config.json

# ----- Prediction Settings -----
IMAGE_WEIGHT=0.70
SYMPTOM_WEIGHT=0.30
LOW_CONFIDENCE_THRESHOLD=0.60
CONFLICT_THRESHOLD=0.30

# ----- LLM Integration -----
# Options: gemini, openai, none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# ----- App Settings -----
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_IMAGE_SIZE_MB=10

# ----- Transactional Email (SMTP) -----
# Configure with SendGrid, Mailgun, Amazon SES, Resend, Brevo, or custom SMTP
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-smtp-api-key-or-password
SMTP_FROM_EMAIL=support@dermaassist.ai
SMTP_FROM_NAME=DermaAssist Clinical Support
SMTP_USE_TLS=true

# ----- Frontend & Password Reset -----
FRONTEND_URL=http://localhost:5173
RESET_TOKEN_EXPIRY_MINUTES=60

# ============================================================
# Derma Assist Frontend — Vercel Environment Variables
# ============================================================
# In Vercel Project Settings -> Environment Variables, add:
#
# 1. VITE_API_URL (Required for production deployment)
# The full URL of your deployed FastAPI backend (e.g. Render, Railway, Fly.io, EC2)
# Example: https://derma-assist-api.onrender.com
VITE_API_URL=https://your-backend-api.onrender.com

# 2. VITE_GOOGLE_CLIENT_ID (Optional)
# Google OAuth 2.0 Client ID from Google Cloud Console (if Google Sign-In is enabled)
# Example: 1234567890-abcdefg.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
